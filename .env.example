# --- Muse Spark Open endpoint (OpenAI-compatible) -------------------------------------------
# Baseten (hackathon): https://inference.baseten.co/v1   model: meta-models/muse-spark-open-1026
# Modal / Fireworks / Meta Model API: use that provider's base URL and model id from its docs.
LLM_BASE_URL=https://inference.baseten.co/v1
LLM_API_KEY=
LLM_MODEL=meta-models/muse-spark-open-1026
# USD per 1M tokens, used for the cost ledger (defaults are the rate listed for Modal's shared
# endpoint). Replace with your provider's real prices.
LLM_PRICE_IN=1.25
LLM_PRICE_OUT=4.25

# --- Localizer ---------------------------------------------------------------------------------
PID_SEGMENTER=modal            # modal = SAM 3.1 on Modal, vlm = experimental fallback
PID_MODAL_APP=pid-sam
PID_MODAL_CLS=SamServer

# --- API server (optional) -------------------------------------------------------------------
PID_API_KEY=                   # if set, /analyze etc. require  Authorization: Bearer <key>
PID_MAX_UPLOAD_MB=15
PID_MAX_PIXELS=40000000
PID_CACHE_DIR=.cache/llm

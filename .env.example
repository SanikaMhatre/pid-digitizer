# --- Muse model: classifies symbols, reads tags, runs the verification agent (OpenAI-compatible chat) ---
# Meta Model API:  https://api.meta.ai/v1   model: muse-spark-1.3  (use the Standard model, NOT the -contributor one:
#                  Contributor mode lets Meta train on your inputs, which is wrong for confidential drawings)
# Muse Spark Open is download-only on Meta's side; a hosted provider such as Baseten serves it:
#                  https://inference.baseten.co/v1   model: meta-models/muse-spark-open-1026
LLM_BASE_URL=https://api.meta.ai/v1
LLM_API_KEY=
LLM_MODEL=muse-spark-1.3
# USD per 1M tokens, used for the cost ledger. These are PLACEHOLDERS: set your provider's real prices.
LLM_PRICE_IN=1.25
LLM_PRICE_OUT=4.25

# --- Localizer ---------------------------------------------------------------------------------
# sam  = SAM 3.1 on the Meta Model API (default).  muse = the Muse model finds the boxes itself.
PID_LOCALIZER=sam
SAM_BASE_URL=https://api.meta.ai/v1
SAM_API_KEY=                   # leave empty to reuse LLM_API_KEY (same Meta key)
# SAM_PROMPTS=symbol,rectangle,circle   # phrases SAM is asked for; tune with `python -m pid.smoke sam-debug`

# --- API server (optional) -------------------------------------------------------------------
PID_API_KEY=                   # if set, /analyze etc. require  Authorization: Bearer <key>
PID_MAX_UPLOAD_MB=15
PID_MAX_PIXELS=40000000
PID_CACHE_DIR=.cache/llm
